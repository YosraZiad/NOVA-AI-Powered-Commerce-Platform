APP_NAME="NOVA — AI-Powered Commerce Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nova-commerce.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL recommended for Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nova_production
DB_USERNAME=nova_user
DB_PASSWORD=secret_db_password

# Session & Cookie Security (Production defaults)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Security & Reverse Proxy Settings
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS="https://nova-commerce.example.com"

# Queue & Storage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@nova-commerce.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# NOVA Business & Deployment Configuration
# 'hosted': Centrally hosted isolated multi-tenant deployment
# 'standalone': Client-owned, independently deployed single-store installation
NOVA_DEPLOYMENT_MODE=hosted
NOVA_DEFAULT_CURRENCY=SAR

# NOVA AI Provider Subsystem
# 'auto': Tries OpenAI, then Gemini, then Deterministic Local Engine
# 'openai': OpenAI GPT API
# 'gemini': Google Gemini API
# 'deterministic': Verified Local Reasoning Engine (No External API Keys Required)
NOVA_AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
NOVA_AI_MAX_TOKENS=800
NOVA_AI_TEMPERATURE=0.3
NOVA_AI_TIMEOUT=10
NOVA_AI_RATE_LIMIT=60

VITE_APP_NAME="${APP_NAME}"
